# UniversityAI 環境變數範本
#
# 用法：cp .env.example .env  然後改掉密碼。
# .env 不進版控（見 .gitignore），.env.example 進。
#
# 這是本機開發與展示用的環境（D-04），不會對外開放，但仍不要把真實的
# API 金鑰寫進 .env.example——它會進版控。

# ---------------------------------------------------------------------------
# Moodle 版本
#
# 釘標籤而非分支：MOODLE_502_STABLE 這類分支會持續前進，釘它就無法保證
# 換一台機器重建會得到同一套系統（NFR-MNT-05）。
# 目標版本的選擇理由見 docs/SRS.md 的 D-09。
# ---------------------------------------------------------------------------
MOODLE_TAG=v5.2.2

# ---------------------------------------------------------------------------
# 對外埠號
#
# 改這裡就好，不要改 compose.yaml。若與主機上既有的服務衝突就換一個。
# 注意 MOODLE_PORT 改了之後 MOODLE_WWWROOT 也要跟著改。
# ---------------------------------------------------------------------------
MOODLE_PORT=8080
MAILPIT_PORT=8025
SELENIUM_VNC_PORT=7900
POSTGRES_PORT=55432

# ---------------------------------------------------------------------------
# 資料庫
# ---------------------------------------------------------------------------
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=change-me-in-your-dotenv

# ---------------------------------------------------------------------------
# 站台
#
# MOODLE_WWWROOT 是給人用瀏覽器連的位址，必須與 MOODLE_PORT 一致。
# Behat 用的位址不同（http://moodle，容器名稱），設定在
# docker/config-extra.php 裡，不在這裡——那個值與主機埠號無關。
# ---------------------------------------------------------------------------
MOODLE_WWWROOT=http://localhost:8080
MOODLE_LANG=zh_tw
MOODLE_SITE_FULLNAME=University AI Smart Course Assistant
MOODLE_SITE_SHORTNAME=UniversityAI

MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Change-me-1!
MOODLE_ADMIN_EMAIL=admin@example.invalid

# ---------------------------------------------------------------------------
# 示範課程
#
# D-10 之後課程外殼必須先存在才能上傳課綱，所以 make install 會建一門空課。
# ---------------------------------------------------------------------------
DEMO_COURSE_SHORTNAME=UAI101
DEMO_COURSE_FULLNAME=課綱助理示範課程

# ---------------------------------------------------------------------------
# Claude API
#
# 第一‧五階段才會用到（SRS §8.4）。金鑰不寫在這裡也可以——正式的設定位置
# 是 Moodle 站台設定中的密碼欄位（NFR-SEC-05），這裡只是給評測工具鏈用的。
# 真實金鑰只寫進 .env，絕不寫進 .env.example。
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
