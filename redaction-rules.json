{
  "$comment": [
    "外送資料的白名單、黑名單與去識別化規則（SRS NFR-SEC-06）。",
    "",
    "這份檔案是 A-05 的核心：PHP 端的過濾元件與 Python 端的測試集去識別化",
    "讀同一份規則。跨語言無法共用實作，能共用的是規則資料加上一組共用的",
    "黃金樣本——任一邊新增規則卻沒補樣本，另一邊的測試就會失敗。",
    "",
    "第一階段只需要這份骨架存在（compose 會以唯讀掛載它）。實際的樣式與",
    "驗證樣本於第三階段隨過濾元件一起補齊。"
  ],

  "version": 1,

  "allowlist": {
    "$comment": "只有這些內容得以送往語言模型，其餘一律不送。",
    "fields": [
      "syllabus.raw_text",
      "syllabus.structured",
      "course.fullname",
      "course.summary",
      "event.title",
      "event.due_date",
      "chat.user_question"
    ]
  },

  "denylist": {
    "$comment": "即使出現在白名單內容之中，也須於送出前移除。",
    "categories": [
      "person_name",
      "student_id",
      "email",
      "phone",
      "postal_address",
      "moodle_user_id",
      "ip_address",
      "grade",
      "assignment_content"
    ]
  },

  "patterns": {
    "$comment": [
      "以類別為鍵，值為樣式清單。第三階段補齊。",
      "email 與 ip_address 先放進來作為格式範例。"
    ],
    "email": [
      {
        "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
        "replacement": "[EMAIL]"
      }
    ],
    "ip_address": [
      {
        "regex": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
        "replacement": "[IP]"
      }
    ],
    "person_name": [],
    "student_id": [],
    "phone": [],
    "postal_address": [],
    "moodle_user_id": [],
    "grade": [],
    "assignment_content": []
  },

  "options": {
    "$comment": [
      "teacher_name_from_syllabus：授課教師姓名與聯絡方式須在進入解析之前",
      "即自課綱原文中移除，不是送出前才移除——這一點 SRS 有明文要求。"
    ],
    "teacher_name_from_syllabus": true,
    "user_reference_style": "context_local_alias",
    "filter_error_messages": true
  }
}
